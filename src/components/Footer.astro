---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { TOOLS } from '../data/tools';
import { donation } from '../lib/offers';
const support = donation();
const year = new Date().getFullYear();
import { u } from '../lib/url';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href={u('/')}><span class="logo-mark"><Icon name="shieldCheck" size={20} /></span>{SITE.name}</a>
        <p style="margin-top:12px;max-width:320px">Free photo metadata tools that run entirely in your browser. Your photos never leave your device.</p>
        {support && (
          <a class:list={['btn btn-sm support-btn', { placeholder: !support.ready }]} href={support.ready ? support.url : '#'} target="_blank" rel="noopener" title={support.ready ? undefined : 'Placeholder: set donate.url in src/data/monetization.ts'}>
            <Icon name="zap" size={16} /> {support.label}
          </a>
        )}
      </div>
      <div>
        <h3>Inspect</h3>
        <ul>{TOOLS.filter((t) => t.cluster === 'inspect').map((t) => <li><a href={u(`/${t.slug}/`)}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <h3>Clean &amp; analyze</h3>
        <ul>{TOOLS.filter((t) => t.cluster !== 'inspect').map((t) => <li><a href={u(`/${t.slug}/`)}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <h3>Learn</h3>
        <ul>
          <li><a href={u('/guides/what-is-exif-data/')}>What is EXIF data?</a></li>
          <li><a href={u('/guides/how-to-remove-location-from-photos/')}>Remove location from photos</a></li>
          <li><a href={u('/privacy/')}>How we protect your privacy</a></li>
          <li><a href={u('/about/')}>About</a></li>
          <li><a href={u('/disclosure/')}>Affiliate disclosure</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name}. All processing happens on your device.</span>
      <span>Made by {SITE.author}</span>
    </div>
  </div>
</footer>
