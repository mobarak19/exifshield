---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogType?: string;
}
const { title, description, jsonLd = [], ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(u('/og-image.png'), Astro.site ?? SITE.url).href;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(u('/'), Astro.site ?? SITE.url).href,
  },
  ...jsonLd,
];
import { u } from '../lib/url';
import { appStoreId } from '../lib/offers';
---
<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={u('/manifest.webmanifest')} />
    <meta name="theme-color" content="#f5f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0e13" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {appStoreId() && <meta name="apple-itunes-app" content={`app-id=${appStoreId()}`} />}
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://tile.openstreetmap.org; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
      />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {import.meta.env.PROD && SITE.analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}></script>
    )}
    <script>
      import { u } from '../lib/url';
      // Close the Tools menu when clicking elsewhere or pressing Escape.
      const nav = document.querySelector<HTMLDetailsElement>('[data-nav-tools]');
      document.addEventListener('click', (e) => {
        if (nav?.open && !nav.contains(e.target as Node)) nav.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.open) nav.open = false;
      });
      // Offline support: the tools keep working without a connection.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register(u('/sw.js')).catch(() => {}));
      }
    </script>
  </body>
</html>
